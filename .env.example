# CMS / database
DB_FILE_NAME=./data/portfolio.db
SITE_URL=https://mortezaom.dev

# Admin panel (single admin from env)
ADMIN_USERNAME=admin
# scrypt hash "salt:derivedKey" (hex). Generate with: pnpm cms:hash-password
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=change-me-to-32-plus-random-bytes

# Contact form + Resend (all optional; form still saves to DB without them)
# Get key at https://resend.com/api-keys
RESEND_API_KEY=
# Where notification emails go (your personal inbox)
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Contact <hello@mortezaom.dev>"
CONTACT_FROM_EMAIL=
